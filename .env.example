GRAFANA_URL=http://localhost:3000
# admin unlocks the decrypted alerting export and /api/admin/settings
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# service-account token (Editor/Admin): enough to push rules and policies
GRAFANA_API_KEY=glsa_xxx
# datasource NAME that `datasourceUid: default` in rule files resolves to
GRAFANA_DEFAULT_DATASOURCE=default
GRAFANA_CRITICAL_RECEIVER=critical-alerts

# Git Sync (scripts/grafana-gitsync-connect.py)
GRAFANA_GITSYNC_REPO_URL=https://github.com/acme/grafana
GRAFANA_GITSYNC_BRANCH=main
GRAFANA_GITSYNC_PATH=dashboards
# either a GitHub App ...
GRAFANA_GITHUB_APP_ID=
GRAFANA_GITHUB_INSTALLATION_ID=
GRAFANA_GITHUB_PRIVATE_KEY_FILE=grafana-sync.private-key.pem
# ... or a token (no Connection, no App)
GRAFANA_GITSYNC_TOKEN=
